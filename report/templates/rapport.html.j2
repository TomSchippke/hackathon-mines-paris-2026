<!doctype html>
{#- Rapport opérationnel (exploitation) : CSS en ligne, aucun JavaScript, aucune ressource externe. -#}
{% from "_macros.html.j2" import incident, incidents, action_text, badges %}
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rapport opérationnel</title>
<style>
{% include "_style.css" %}
</style>
</head>
<body>
<main>
{% set h = header %}
<header id="entete">
  <h1>Rapport opérationnel de fiabilité</h1>
  <p class="scope">{{ h.n_incidents|num }} incidents du {{ h.date_min }} au {{ h.date_max }},
    {{ h.sites|length }} sites, {{ h.n_equipment|num }} équipements ({{ h.asset_types|join(" et ") }}).
    Généré le {{ h.generated }}. <a class="pagelink" href="{{ method_name }}">Méthode et limites&nbsp;→</a></p>
  <div class="kpis">
    <div class="kpi"><b class="num">{{ h.total_cost|eur }}</b><span>coût total des incidents</span></div>
    <div class="kpi"><b class="num">{{ h.total_downtime|hours }}</b><span>arrêt total</span></div>
    <div class="kpi"><b class="num">{{ targets|length }} cibles</b><span>équipements ou sites à traiter ({{ targets_cost|eur }})</span></div>
    <div class="kpi"><b class="num">{{ fleet|length }} programmes</b><span>actions sur toute la flotte</span></div>
  </div>
  <nav class="toc" aria-label="Sommaire">
    <a href="#ciblees">Actions ciblées</a><a href="#flotte">Programmes flotte</a><a href="#preuves">Preuves par groupe</a>
    <a href="#sans-action">Sans action requise</a><a href="{{ method_name }}">Méthode et limites</a>
  </nav>
</header>

<section id="ciblees">
  <h2>Actions ciblées</h2>
  <p class="intro">Une ligne par équipement ou site, classée par le coût de ses propres incidents. Une cible
    est retenue quand ses incidents y sont statistiquement sur-représentés (<span class="badge concentration">concentration</span>)
    ou quand leur sévérité ne fait que monter (<span class="badge escalade">escalade</span>). Toute série en
    escalade a une ligne&nbsp;: sans action proposée, le code ajoute une inspection (<span class="badge veille">ajoutée par le code</span>).</p>
  {% if targets %}
  <div class="table-wrap"><table class="plan">
    <thead><tr><th>Cible</th><th>Actions</th><th class="r">Coût de la cible</th></tr></thead>
    <tbody>
    {% for r in targets %}
      <tr{% if r.escalation %} class="escalating"{% endif %}>
        <td><span class="target">{{ r.name }}</span>
          <div class="target-meta">{{ r.kind }}{% if r.site %} · {{ r.site }}{% endif %}</div></td>
        <td><ul class="acts">
          {% for x in r.actions %}{% set a = x.action %}
          <li{% if x.anchor %} id="{{ a.id }}"{% endif %}><span class="aid">{{ a.id }}</span> {{ action_text(a) }}
            <div class="act-meta">
              {% if x.target.escalation %}<span class="urgent">{{ urgency_escalation }}</span>{% endif %}
              {% for g in x.groups %}<a href="#{{ g.anchor }}">{{ g.title }}</a>
              <span class="num">{{ g.n }} incident{% if g.n > 1 %}s{% endif %}, {{ g.cost|eur }}</span>{% endfor %}
              {{ badges(a) }}
            </div></li>
          {% endfor %}
        </ul></td>
        <td class="cost"><span class="num">{{ r.cost|eur }}</span><small>{{ r.n }} incident{% if r.n > 1 %}s{% endif %}</small></td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}
  <p class="muted">Aucune cible : aucun équipement ni site ne concentre un groupe d'incidents.</p>
  {% endif %}
</section>

<section id="flotte">
  <h2>Programmes flotte</h2>
  <p class="intro">Actions à appliquer à tous les équipements du même type, classées par le coût du groupe
    d'incidents qu'elles traitent.</p>
  <div class="table-wrap"><table class="plan">
    <thead><tr><th>Programme</th><th>Groupe traité</th><th class="r">Coût du groupe</th></tr></thead>
    <tbody>
    {% for a in fleet %}
      <tr id="{{ a.id }}">
        <td><span class="aid">{{ a.id }}</span> {{ action_text(a) }}
          <div class="act-meta"><span>Sur l'ensemble des {{ a.fleet_noun }} du parc</span>{{ badges(a) }}</div></td>
        <td><a href="#{{ a.voie_anchor }}">{{ a.voie_title }}</a>
          <div class="target-meta"><span class="badge tier tier-{{ a.tier_slug }}">{{ a.tier }}</span></div></td>
        <td class="cost"><span class="num">{{ a.cost|eur }}</span><small>{{ a.cost_share|share }} du coût</small></td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>

<section id="preuves">
  <h2>Preuves par groupe</h2>
  <p class="intro">Un groupe réunit les incidents qu'une même action corrective permet d'éviter. Chaque fiche
    donne la cause et ses citations, les preuves par cible et les incidents d'origine.</p>
  {% for v in plan %}
  <details class="voie tier-{{ v.tier_slug }}" id="{{ v.anchor }}">
    <summary>
      <h3>{{ v.title }}</h3>
      <div class="voie-meta">
        <span class="badge tier tier-{{ v.tier_slug }}">{{ v.tier }}</span>
        <span class="num">{{ v.total_cost|eur }} ({{ v.cost_share|share }})</span>
        <span class="num">{{ v.frequency }} incidents</span>
        <span class="num">{{ v.downtime|hours }} d'arrêt</span>
        <span>{{ v.partition }}</span>
        <span>Actions&nbsp;: {% for id in v.action_ids %}<a class="ref" href="#{{ id }}">{{ id }}</a>{% endfor %}</span>
      </div>
    </summary>
    <div class="voie-body">
      <div class="fix">
        <p>{{ v.description }}</p>
        <p><b>Cause commune&nbsp;:</b> {{ v.cause }}
          {% if v.cause_source == "citee" %}<span class="badge src">citée des rapports</span>
          {% else %}<span class="badge inferee">cause inférée – à confirmer</span>{% endif %}</p>
      </div>
      {% if v.quotes %}
      <h4>Citations des rapports</h4>
      {% for q in v.quotes %}
      <blockquote><p>«&nbsp;{{ q.text }}&nbsp;»</p>
        {% if q.n %}<p class="small muted">Retrouvée dans {{ q.n }} rapport{% if q.n > 1 %}s{% endif %} du groupe&nbsp;:</p>
        {{ incidents(q.incidents) }}{% if q.more %}<p class="small muted">et {{ q.more }} autre{% if q.more > 1 %}s{% endif %}.</p>{% endif %}
        {% else %}<p class="small muted">Citation non retrouvée dans les rapports du groupe.</p>{% endif %}
      </blockquote>
      {% endfor %}
      {% endif %}
      {% if v.evidence %}
      <h4>Preuves par cible</h4>
      {% for e in v.evidence %}
        {% if e.conc %}
        <p class="evidence"><b>Concentration sur {{ e.name }}&nbsp;:</b> {{ e.conc.observed }} incidents observés pour
          {{ e.conc.expected }} attendus (lift {{ e.conc.lift }}, q&nbsp;=&nbsp;{{ e.conc.q }}), preuve
          <span class="badge {% if e.conc.level == 'forte' %}src{% else %}verifier{% endif %}">{{ e.conc.level }}</span></p>
        {% endif %}
        {% if e.esc %}
        <p class="evidence"><b>Série en escalade sur {{ e.name }}&nbsp;:</b> {{ e.esc.n }} incidents du {{ e.esc.first }}
          au {{ e.esc.last }}, sévérité {{ e.esc.sequence }}, {{ e.esc.total_cost|eur }}.</p>
        <div class="legend" aria-hidden="true"><span><i class="sw sev-mineure"></i>mineure</span><span><i class="sw sev-moderee"></i>modérée</span><span><i class="sw sev-severe"></i>sévère</span></div>
        <div class="chart-wrap">{{ e.esc.svg }}</div>
        {{ incidents(e.esc.points) }}
        {% endif %}
      {% endfor %}
      {% endif %}
      <h4>Modes de défaillance couverts</h4>
      <div class="table-wrap"><table>
        <thead><tr><th>Mode de défaillance</th><th>Description</th><th class="r">Incidents</th></tr></thead>
        <tbody>{% for f in v.fine %}<tr><td>{{ f.title }}</td><td>{{ f.failure_mode }}</td><td class="r num">{{ f.size }}</td></tr>{% endfor %}</tbody>
      </table></div>
      <h4>Incidents représentatifs</h4>
      <p class="small muted">Le plus coûteux de chaque mode de défaillance. Lien&nbsp;: rapport PDF&nbsp;; sinon, texte du CSV dépliable.</p>
      {{ incidents(v.representatives) }}
    </div>
  </details>
  {% endfor %}
</section>

<section id="sans-action">
  <h2>Sans action requise</h2>
  {% if no_action.nominal %}
  <h3>Fonctionnements nominaux</h3>
  <p class="small muted">Une protection s'est déclenchée en réaction à une condition extérieure citée dans les rapports,
    sans défaut constaté, et la plupart des incidents sont de sévérité mineure&nbsp;: aucun correctif à engager.</p>
  {% for v in no_action.nominal %}
  <div class="card" id="{{ v.anchor }}">
    <h3>{{ v.title }}</h3>
    <div class="voie-meta">
      <span class="badge tier tier-{{ v.tier_slug }}">{{ v.tier }}</span>
      <span class="num">{{ v.total_cost|eur }} ({{ v.cost_share|share }})</span>
      <span class="num">{{ v.frequency }} incidents</span>
      <span class="num">{{ v.mild_share|pct }} mineurs</span>
    </div>
    <p><b>Condition extérieure&nbsp;:</b> {{ v.condition }}</p>
    {% if v.quote %}
    <blockquote><p>«&nbsp;{{ v.quote.text }}&nbsp;»</p>
      {% if v.quote.n %}<p class="small muted">Retrouvée dans {{ v.quote.n }} rapport{% if v.quote.n > 1 %}s{% endif %}&nbsp;:</p>{{ incidents(v.quote.incidents) }}{% endif %}
    </blockquote>
    {% endif %}
    {% if v.reason %}<p class="small">{{ v.reason }}</p>{% endif %}
  </div>
  {% endfor %}
  {% endif %}
  {% if no_action.isolated.n %}
  <h3>Incidents isolés</h3>
  <div class="card">
    <p>{{ no_action.isolated.n }} incidents ne se rattachent à aucun groupe récurrent ({{ no_action.isolated.cost|eur }})&nbsp;:
      traitement au cas par cas, sans action de flotte.</p>
    {{ incidents(no_action.isolated.incidents) }}
  </div>
  {% endif %}
</section>
</main>
</body>
</html>
